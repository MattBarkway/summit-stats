  "query": "\n                SELECT\n                    r.athlete_id,\n                    u.firstname,\n                    u.lastname,\n                    u.profile_url,\n                    r.best_time_s,\n                    r.rank\n                FROM segment_challenge_results r\n                JOIN users u ON u.athlete_id = r.athlete_id\n                WHERE r.challenge_id = $1\n                ORDER BY r.rank\n                ",
