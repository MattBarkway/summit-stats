  "query": "\n        SELECT\n            g.cycle_type::text AS \"cycle_type!\",\n            cb.start_at        AS \"start_at!\",\n            cb.end_at          AS \"end_at!\"\n        FROM groups g\n        CROSS JOIN LATERAL cycle_bounds(g.cycle_type) cb\n        WHERE g.id = $1\n        ",
