{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT b.slug, b.name, b.description, b.icon, ub.awarded_at, ub.context\n        FROM user_badges ub\n        JOIN badges b ON b.id = ub.badge_id\n        WHERE ub.athlete_id = $1\n          AND (ub.group_id = $2 OR ub.group_id IS NULL)\n        ORDER BY ub.awarded_at DESC\n        ",
