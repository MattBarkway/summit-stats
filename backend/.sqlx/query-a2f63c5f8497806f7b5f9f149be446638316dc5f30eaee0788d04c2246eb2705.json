{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            g.id,\n            g.name,\n            g.description,\n            g.icon_url,\n            g.invite_code,\n            g.owner_id,\n            g.cycle_type       AS \"cycle_type!: CycleType\",\n            cb.start_at        AS \"cycle_start!\",\n            cb.end_at          AS \"cycle_end!\"\n        FROM groups g\n        CROSS JOIN LATERAL cycle_bounds(g.cycle_type) cb\n        WHERE g.id = $1\n        ",
