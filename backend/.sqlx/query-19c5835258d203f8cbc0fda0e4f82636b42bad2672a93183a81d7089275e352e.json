  "query": "\n        SELECT u.athlete_id, u.firstname, u.lastname, u.profile_url\n        FROM group_members gm\n        JOIN users u ON u.athlete_id = gm.athlete_id\n        WHERE gm.group_id = $1\n        ORDER BY gm.joined_at\n        ",
